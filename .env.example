PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host/database
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=verified-sender@example.com
EMAIL_USER=verified-sender@example.com
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_CLIENT_ID=your_oauth_client_id
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token
# סוד חתימת הטוקנים — חשוב להשתמש בערך ארוך ואקראי בסביבת הייצור
JWT_SECRET=your_long_random_secret
# התחברות באמצעות גוגל (OAuth Client מסוג "Web application" ב-Google Cloud Console)
# ללא GOOGLE_LOGIN_CLIENT_ID/SECRET — השרת משתמש ב-GOOGLE_CLIENT_ID/SECRET שלמעלה
GOOGLE_LOGIN_CLIENT_ID=your_google_login_client_id
GOOGLE_LOGIN_CLIENT_SECRET=your_google_login_client_secret
# אופציונלי: לקביעת כתובת ה-callback במפורש (למשל מאחורי פרוקסי)
# GOOGLE_LOGIN_REDIRECT_URI=https://your-domain/api/auth/google/callback
# כתובת היעד לדיווחי תקלות ובקשות פיצ'רים
FEEDBACK_EMAIL=mr56793061@gmail.com
